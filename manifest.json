{
    "manifest_version": 3,
    "name": "__MSG_extension_name__",
    "version": "2.1.0",
    "description": "__MSG_extension_description__",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.crunchyroll.com/*",
                "*://static.crunchyroll.com/*"
            ],
            "js": [
                "inject.js"
            ],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": true
        },
        {
            "matches": [
                "*://*.crunchyroll.com/*",
                "*://static.crunchyroll.com/*"
            ],
            "css": [
                "content.css"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "*://*.primevideo.com/*",
                "*://*.amazon.com/gp/video/*",
                "*://*.amazon.co.uk/gp/video/*",
                "*://*.amazon.de/gp/video/*",
                "*://*.amazon.co.jp/gp/video/*",
                "*://*.amazon.fr/gp/video/*",
                "*://*.amazon.it/gp/video/*",
                "*://*.amazon.es/gp/video/*",
                "*://*.amazon.ca/gp/video/*",
                "*://*.amazon.com.au/gp/video/*",
                "*://*.amazon.in/gp/video/*"
            ],
            "js": [
                "inject-prime.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "*://*.primevideo.com/*",
                "*://*.amazon.com/gp/video/*",
                "*://*.amazon.co.uk/gp/video/*",
                "*://*.amazon.de/gp/video/*",
                "*://*.amazon.co.jp/gp/video/*",
                "*://*.amazon.fr/gp/video/*",
                "*://*.amazon.it/gp/video/*",
                "*://*.amazon.es/gp/video/*",
                "*://*.amazon.ca/gp/video/*",
                "*://*.amazon.com.au/gp/video/*",
                "*://*.amazon.in/gp/video/*"
            ],
            "css": [
                "content.css"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "inject.js"
            ],
            "matches": [
                "*://*.crunchyroll.com/*",
                "*://static.crunchyroll.com/*"
            ]
        },
        {
            "resources": [
                "inject-prime.js"
            ],
            "matches": [
                "*://*.primevideo.com/*",
                "*://*.amazon.com/*",
                "*://*.amazon.co.uk/*",
                "*://*.amazon.de/*",
                "*://*.amazon.co.jp/*",
                "*://*.amazon.fr/*",
                "*://*.amazon.it/*",
                "*://*.amazon.es/*",
                "*://*.amazon.ca/*",
                "*://*.amazon.com.au/*",
                "*://*.amazon.in/*"
            ]
        }
    ],
    "default_locale": "en",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
